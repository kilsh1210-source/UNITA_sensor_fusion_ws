<?xml version="1.0"?>
<robot name="unita_minicar">

  <!--
    Coordinate convention
    X: forward
    Y: left
    Z: up

    Dimensions converted from cm to m.

    Chassis:
      length: 0.995
      width: 0.460
      height: 0.207
      chassis bottom height from ground: 0.071

    Wheels:
      diameter: 0.180
      radius: 0.090
      track width: 0.488
      front axle x: +0.290
      rear axle x: -0.255

    LiDAR:
      x: +0.500 from center
      height from ground: 0.190

    Camera:
      x: -0.230 from center
      height from ground: 0.740

    Front wheels:
      steering only in RViz

    Rear wheels:
      continuous rotation
  -->

  <!-- ========================================================= -->
  <!-- BASE FOOTPRINT -->
  <!-- ========================================================= -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.071" rpy="0 0 0"/>
  </joint>


  <!-- ========================================================= -->
  <!-- BASE LINK -->
  <!-- ========================================================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.1035" rpy="0 0 0"/>
      <geometry>
        <box size="0.995 0.460 0.207"/>
      </geometry>

      <material name="body_material">
        <color rgba="0.25 0.25 0.25 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.1035" rpy="0 0 0"/>
      <geometry>
        <box size="0.995 0.460 0.207"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.1035" rpy="0 0 0"/>

      <mass value="8.0"/>

      <inertia
        ixx="0.170"
        ixy="0.0"
        ixz="0.0"
        iyy="0.690"
        iyz="0.0"
        izz="0.800"
      />
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- FRONT LEFT STEERING LINK -->
  <!-- ========================================================= -->

  <link name="front_left_steering_link"/>

  <joint name="front_left_steering_joint" type="revolute">

    <parent link="base_link"/>
    <child link="front_left_steering_link"/>

    <origin
      xyz="0.290 0.244 0.019"
      rpy="0 0 0"
    />

    <axis xyz="0 0 1"/>

    <limit
      lower="-0.60"
      upper="0.60"
      effort="50"
      velocity="2.0"
    />

  </joint>


  <!-- ========================================================= -->
  <!-- FRONT LEFT WHEEL -->
  <!-- ========================================================= -->

  <link name="front_left_wheel">

    <visual>

      <origin
        xyz="0 0 0"
        rpy="1.57079632679 0 0"
      />

      <geometry>
        <cylinder
          radius="0.090"
          length="0.040"
        />
      </geometry>

      <material name="wheel_material">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>

    </visual>


    <collision>

      <origin
        xyz="0 0 0"
        rpy="1.57079632679 0 0"
      />

      <geometry>
        <cylinder
          radius="0.090"
          length="0.040"
        />
      </geometry>

    </collision>


    <inertial>

      <mass value="0.3"/>

      <inertia
        ixx="0.0013"
        ixy="0"
        ixz="0"
        iyy="0.0024"
        iyz="0"
        izz="0.0013"
      />

    </inertial>

  </link>


  <!--
    Front wheel does not spin.
    It only changes direction through the steering joint.
  -->

  <joint name="front_left_wheel_joint" type="fixed">

    <parent link="front_left_steering_link"/>
    <child link="front_left_wheel"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"
    />

  </joint>


  <!-- ========================================================= -->
  <!-- FRONT RIGHT STEERING LINK -->
  <!-- ========================================================= -->

  <link name="front_right_steering_link"/>

  <joint name="front_right_steering_joint" type="revolute">

    <parent link="base_link"/>
    <child link="front_right_steering_link"/>

    <origin
      xyz="0.290 -0.244 0.019"
      rpy="0 0 0"
    />

    <axis xyz="0 0 1"/>

    <limit
      lower="-0.60"
      upper="0.60"
      effort="50"
      velocity="2.0"
    />

  </joint>


  <!-- ========================================================= -->
  <!-- FRONT RIGHT WHEEL -->
  <!-- ========================================================= -->

  <link name="front_right_wheel">

    <visual>

      <origin
        xyz="0 0 0"
        rpy="1.57079632679 0 0"
      />

      <geometry>
        <cylinder
          radius="0.090"
          length="0.040"
        />
      </geometry>

      <material name="wheel_material"/>

    </visual>


    <collision>

      <origin
        xyz="0 0 0"
        rpy="1.57079632679 0 0"
      />

      <geometry>
        <cylinder
          radius="0.090"
          length="0.040"
        />
      </geometry>

    </collision>


    <inertial>

      <mass value="0.3"/>

      <inertia
        ixx="0.0013"
        ixy="0"
        ixz="0"
        iyy="0.0024"
        iyz="0"
        izz="0.0013"
      />

    </inertial>

  </link>


  <!--
    Front wheel does not spin.
    It only changes direction through the steering joint.
  -->

  <joint name="front_right_wheel_joint" type="fixed">

    <parent link="front_right_steering_link"/>
    <child link="front_right_wheel"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"
    />

  </joint>


  <!-- ========================================================= -->
  <!-- REAR LEFT WHEEL -->
  <!-- ========================================================= -->

  <link name="rear_left_wheel">

    <visual>

      <origin
        xyz="0 0 0"
        rpy="1.57079632679 0 0"
      />

      <geometry>
        <cylinder
          radius="0.090"
          length="0.040"
        />
      </geometry>

      <material name="wheel_material"/>

    </visual>


    <collision>

      <origin
        xyz="0 0 0"
        rpy="1.57079632679 0 0"
      />

      <geometry>
        <cylinder
          radius="0.090"
          length="0.040"
        />
      </geometry>

    </collision>


    <inertial>

      <mass value="0.3"/>

      <inertia
        ixx="0.0013"
        ixy="0"
        ixz="0"
        iyy="0.0024"
        iyz="0"
        izz="0.0013"
      />

    </inertial>

  </link>


  <!-- Rear wheel can rotate continuously -->

  <joint name="rear_left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="rear_left_wheel"/>

    <origin
      xyz="-0.255 0.244 0.019"
      rpy="0 0 0"
    />

    <axis xyz="0 1 0"/>

    <limit
      effort="50"
      velocity="30"
    />

  </joint>


  <!-- ========================================================= -->
  <!-- REAR RIGHT WHEEL -->
  <!-- ========================================================= -->

  <link name="rear_right_wheel">

    <visual>

      <origin
        xyz="0 0 0"
        rpy="1.57079632679 0 0"
      />

      <geometry>
        <cylinder
          radius="0.090"
          length="0.040"
        />
      </geometry>

      <material name="wheel_material"/>

    </visual>


    <collision>

      <origin
        xyz="0 0 0"
        rpy="1.57079632679 0 0"
      />

      <geometry>
        <cylinder
          radius="0.090"
          length="0.040"
        />
      </geometry>

    </collision>


    <inertial>

      <mass value="0.3"/>

      <inertia
        ixx="0.0013"
        ixy="0"
        ixz="0"
        iyy="0.0024"
        iyz="0"
        izz="0.0013"
      />

    </inertial>

  </link>


  <!-- Rear wheel can rotate continuously -->

  <joint name="rear_right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="rear_right_wheel"/>

    <origin
      xyz="-0.255 -0.244 0.019"
      rpy="0 0 0"
    />

    <axis xyz="0 1 0"/>

    <limit
      effort="50"
      velocity="30"
    />

  </joint>


  <!-- ========================================================= -->
  <!-- LIDAR -->
  <!-- ========================================================= -->

  <!-- 링크 이름 laser: rplidar_node의 frame_id, image_fusion_node의 lidar_frame_id,
       l_shape_node 등 기존 코드 전반이 라이다 프레임을 'laser'로 참조하는 것과 맞춤
       (원본 파일은 lidar_link였음) -->
  <link name="laser">

    <visual>

      <geometry>
        <cylinder
          radius="0.035"
          length="0.040"
        />
      </geometry>

      <material name="lidar_material">
        <color rgba="0.1 0.1 0.8 1.0"/>
      </material>

    </visual>


    <collision>

      <geometry>
        <cylinder
          radius="0.035"
          length="0.040"
        />
      </geometry>

    </collision>


    <inertial>

      <mass value="0.2"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0002"
      />

    </inertial>

  </link>


  <joint name="lidar_joint" type="fixed">

    <parent link="base_link"/>
    <child link="laser"/>

    <origin
      xyz="0.500 0 0.119"
      rpy="0 0 0"
    />

  </joint>


  <!-- ========================================================= -->
  <!-- CAMERA -->
  <!-- ========================================================= -->

  <link name="camera_link">

    <visual>

      <geometry>
        <box size="0.060 0.040 0.040"/>
      </geometry>

      <material name="camera_material">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>

    </visual>


    <collision>

      <geometry>
        <box size="0.060 0.040 0.040"/>
      </geometry>

    </collision>


    <inertial>

      <mass value="0.15"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"
      />

    </inertial>

  </link>


  <!--
    Camera is 23 cm behind vehicle center.
    Ground height = 0.740 m
    base_link is 0.071 m above ground
    relative Z = 0.740 - 0.071 = 0.669 m
  -->

  <joint name="camera_joint" type="fixed">

    <parent link="base_link"/>
    <child link="camera_link"/>

    <origin
      xyz="-0.230 0 0.669"
      rpy="0 0 0"
    />

  </joint>


  <!-- ========================================================= -->
  <!-- CAMERA OPTICAL FRAME -->
  <!-- ========================================================= -->

  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">

    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>

    <origin
      xyz="0 0 0"
      rpy="-1.57079632679 0 -1.57079632679"
    />

  </joint>

</robot>
